# EÜDOK – Web-Root (in Plesk als Dokumentstamm eintragen)
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Nur HTTPS (lokal ausgenommen)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # altes statisches Manifest → dynamisch (Name aus den Einstellungen)
  RewriteRule ^manifest\.webmanifest$ manifest.php [L]

  # QR-Schnellerfassung: /q/<key> (Aufkleber) und /q (laufende QR-Sitzung)
  RewriteRule ^q/([0-9A-Za-z-]{20,64})/?$ quick-entry.php?key=$1 [L,QSA]
  RewriteRule ^q/?$ quick-entry.php [L,QSA]

  # Sprechende Pfade (gleiche Regeln in tools/dev-router.php für den lokalen PHP-Server)
  RewriteRule ^login/?$ index.php?login=1 [L,QSA]
  RewriteRule ^login/code/?$ index.php?login=code [L,QSA]
  RewriteRule ^actions/(login|logout|code|new|discard|resend)$ index.php?action=$1 [L,QSA]
  RewriteRule ^setup/?$ setup.php [L,QSA]
  RewriteRule ^account/?$ index.php?view=account [L,QSA]
  RewriteRule ^reports/?$ index.php?view=reports [L,QSA]
  RewriteRule ^reports/(\d{4}|all)\.zip$ download.php?zip=$1 [L,QSA]
  RewriteRule ^reports/([A-Za-z0-9._-]+)/(pdf|json)$ download.php?n=$1&f=$2 [L,QSA]
  RewriteRule ^reports/([A-Za-z0-9._-]+)/attachments/([A-Za-z0-9._-]+\.(jpg|png))$ download.php?n=$1&a=$2 [L,QSA]
  RewriteRule ^reports/([A-Za-z0-9._-]+)/confirmations/([A-Za-z0-9._-]+\.pdf)$ download.php?n=$1&c=$2 [L,QSA]
  RewriteRule ^reports/([A-Za-z0-9._-]+)/confirmations/?$ confirmations.php?n=$1 [L,QSA]
  RewriteRule ^reports/([A-Za-z0-9._-]+)/edit$ report.php?n=$1&edit=1 [L,QSA]
  RewriteRule ^reports/([A-Za-z0-9._-]+)/?$ report.php?n=$1 [L,QSA]
  RewriteRule ^settings/?$ settings.php [L,QSA]
  RewriteRule ^settings/([a-z]+)/?$ settings.php?s=$1 [L,QSA]
</IfModule>

# Versteckte Dateien sperren
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  # pdf.js-Module: Browser verlangen für ES-Module einen JavaScript-Typ
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
